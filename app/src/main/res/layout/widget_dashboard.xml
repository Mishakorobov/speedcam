<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_dashboard_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_dark"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="6dp">

    <!-- 1-Tap Toggle Button -->
    <FrameLayout
        android:id="@+id/widget_btn_toggle"
        android:layout_width="72dp"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:id="@+id/widget_btn_toggle_inner"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/widget_button_toggle_off"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/widget_btn_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_widget_power" />

            <TextView
                android:id="@+id/widget_btn_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/widget_btn_start"
                android:textColor="#94A3B8"
                android:textSize="11sp"
                android:textStyle="bold" />

        </LinearLayout>

    </FrameLayout>

    <!-- Subtle Divider -->
    <View
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:layout_marginHorizontal="6dp"
        android:layout_marginVertical="6dp"
        android:background="#283144" />

    <!-- Info & App Launcher Area -->
    <FrameLayout
        android:id="@+id/widget_info_container"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:paddingHorizontal="6dp">

        <!-- 1. Inactive State Layout -->
        <LinearLayout
            android:id="@+id/widget_inactive_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:visibility="visible">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_radar_inactive"
                android:textColor="#F8FAFC"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/widget_tap_to_start"
                android:textColor="#94A3B8"
                android:textSize="11sp" />

        </LinearLayout>

        <!-- 2. Active Clear Road State Layout -->
        <LinearLayout
            android:id="@+id/widget_active_clear_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="bottom"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_speed_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#F8FAFC"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_speed_unit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:layout_marginBottom="3dp"
                    android:text="@string/widget_speed_unit"
                    android:textColor="#94A3B8"
                    android:textSize="10sp" />

            </LinearLayout>

            <TextView
                android:id="@+id/widget_road_status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="@string/widget_road_clear"
                android:textColor="#10B981"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- 3. Active Hazard / Approaching Camera State Layout -->
        <LinearLayout
            android:id="@+id/widget_active_hazard_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <!-- Speed Limit Sign Badge -->
            <FrameLayout
                android:id="@+id/widget_limit_badge"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/widget_limit_badge_bg">

                <TextView
                    android:id="@+id/widget_limit_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="60"
                    android:textColor="#111827"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_hazard_distance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="350 m"
                    android:textColor="#F8FAFC"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_hazard_type"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Camera"
                    android:textColor="#94A3B8"
                    android:textSize="10sp" />

            </LinearLayout>

        </LinearLayout>

    </FrameLayout>

</LinearLayout>
